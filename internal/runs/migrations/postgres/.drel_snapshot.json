          "notNull": true
        },
        {
          "name": "wake_at",
          "type": "timestamptz",
          "notNull": false
        },
        {
          "name": "tokens_in",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "tokens_out",
          "type": "bigint",
          "notNull": true
        },
        {
          "name": "cost_usd",
          "type": "double precision",
          "notNull": true
        },
        {
          "name": "started_at",
          "type": "timestamptz",
          "notNull": false
        },
        {
          "name": "finished_at",
          "type": "timestamptz",
          "notNull": false
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "notNull": true,
          "default": "NOW()"
