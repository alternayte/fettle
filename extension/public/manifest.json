{
  "manifest_version": 3,
  "name": "Fettle",
  "description": "Share your sign-in for one site with a Fettle bot, so that the bot does not sign in again.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/alternayte/fettle",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Fettle",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "alarms", "cookies", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
